{"v":1,"id":"atreides/m8-briefing","ms":28445,"lines":["The Ordos and the Harkonnen have set aside their","quarrels and joined against us. One base each lies","in this region, and both must be destroyed.","I suspect the Emperor arranged this alliance.","His Sardaukar will be watching for their chance.","This is the battle that decides Arrakis, Commander.","Fight it as you have fought every other: well."],"words":[[33,166,0,0,3],[352,777,0,4,9],[831,910,0,10,13],[937,990,0,14,17],[1043,1921,0,18,27],[2001,2160,0,28,32],[2240,2426,0,33,36],[2480,2905,0,37,42],[2958,3118,0,43,48],[3171,4102,1,0,8],[4235,4341,1,9,12],[4421,4847,1,13,19],[4900,5352,1,20,27],[5458,5795,1,28,30],[6468,6681,1,32,35],[6734,7133,1,36,40],[7266,7453,1,41,45],[7506,7958,1,46,50],[8011,8091,2,0,2],[8117,8304,2,3,7],[8357,9181,2,8,14],[9367,9500,2,16,19],[9607,10165,2,20,24],[10272,10484,2,25,29],[10538,10617,2,30,32],[10697,11647,2,33,42],[12329,12462,3,0,1],[12515,13020,3,2,9],[13047,13153,3,10,13],[13313,13845,3,14,21],[13951,14749,3,22,30],[14829,15015,3,31,35],[15068,15902,3,36,44],[16547,16706,4,0,3],[16813,17504,4,4,13],[17664,17744,4,14,18],[17797,17877,4,19,21],[18010,18515,4,22,30],[18568,18621,4,31,34],[18701,18861,4,35,40],[18940,19685,4,41,47],[20360,20600,5,0,4],[20679,20786,5,5,7],[20839,20919,5,8,11],[20999,21584,5,12,18],[21637,21770,5,19,23],[21823,22435,5,24,31],[22515,23366,5,32,39],[23499,24279,5,41,50],[24983,25302,6,0,5],[25355,25515,6,6,8],[25595,25701,6,9,11],[25754,25808,6,12,15],[25861,25967,6,16,20],[26073,26419,6,21,27],[26552,26765,6,28,33],[26871,27377,6,34,39],[27616,28306,6,41,45]],"sentences":[[33,5795,0,13,"grave"],[6468,11647,14,25,"grave"],[12329,15902,26,32,"grave"],[16547,19685,33,40,"warning"],[20360,24279,41,48,"grave"],[24983,28306,49,57,"grave"]],"visemes":{"t":[0,33,86,166,272,458,565,671,831,857,937,964,1043,1123,1309,1389,1496,1602,1708,2054,2107,2240,2480,2586,2666,2825,2958,3012,3065,3171,3251,3490,3597,3703,4102,4235,4288,4474,4714,4900,4953,5405,5