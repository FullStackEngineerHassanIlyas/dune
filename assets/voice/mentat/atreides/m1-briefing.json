{"v":1,"id":"atreides/m1-briefing","ms":35738,"lines":["Welcome to Arrakis, Commander. I am Cyril,","Mentat of House Atreides. I will advise you here.","The Emperor cares for one thing here: spice.","His decree gives Arrakis to his best supplier.","We begin with a modest task: harvest spice until","1000 credits are held safely in our stores.","Ordos patrols roam this basin. They have no base,","but they will not leave our Harvester in peace."],"words":[[89,647,0,0,7],[727,834,0,8,10],[913,1711,0,11,18],[1871,2800,0,20,29],[3457,3643,0,31,32],[3643,3829,0,33,35],[3962,4627,0,36,41],[4813,5425,1,0,6],[5478,5584,1,7,9],[5637,5983,1,10,15],[6036,7031,1,16,24],[7736,7842,1,26,27],[7895,8002,1,28,32],[8055,8720,1,33,39],[8799,8906,1,40,43],[9012,9864,1,44,48],[10511,10618,2,0,3],[10724,11070,2,4,11],[11150,11549,2,12,17],[11602,11655,2,18,21],[11735,11948,2,22,25],[12027,12267,2,26,31],[12320,12932,2,32,36],[13171,13954,2,38,43],[14601,14787,3,0,3],[14841,15426,3,4,10],[15612,15851,3,11,16],[15904,16809,3,17,24],[16915,16995,3,25,27],[17021,17181,3,28,31],[17287,17607,3,32,36],[17686,18521,3,37,45],[19145,19225,4,0,2],[19305,19757,4,3,8],[19810,19917,4,9,13],[19943,19996,4,14,15],[20103,20502,4,16,22],[20581,21486,4,23,27],[21698,22151,4,29,36],[22230,23028,4,37,42],[23135,23427,4,43,48],[23480,24172,5,0,4],[24252,24704,5,5,12],[24757,24784,5,13,16],[24863,25103,5,17,21],[25209,25741,5,22,28],[25794,25874,5,29,31],[25927,26007,5,32,35],[26087,26821,5,36,42],[27578,27977,6,0,5],[28057,28881,6,6,13],[29014,29466,6,14,18],[29546,29759,6,19,23],[29839,30593,6,24,29],[31233,31392,6,31,35],[31446,31658,6,36,40],[31712,31898,6,41,43],[32004,32696,6,44,48],[32829,32935,7,0,3],[32988,33148,7,4,8],[33201,33334,7,9,13],[33387,33600,7,14,17],[33653,33892,7,18,23],[33946,34025,7,24,27],[34079,34717,7,28,37],[34797,34903,7,38,40],[34983,35578,7,41,46]],"sentences":[[89,2800,0,3,"grave"],[3457,7031,4,10,"grave"],[7736,9864,11,15,"grave"],[10511,13954,16,23,"grave"],[14601,18521,24,31,"g