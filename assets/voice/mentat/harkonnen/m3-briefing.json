{"v":1,"id":"harkonnen/m3-briefing","ms":26955,"lines":["The Ordos have come, smiling and counting coin.","Merchants. They would sell their own mothers for a","good price, and they think we can be bought too.","Show them otherwise. Find their base and destroy","it. Leave nothing standing.","Mind the open sand. Worms roam here, and they do not","care whose army they swallow."],"words":[[22,133,0,0,3],[272,605,0,4,9],[633,772,0,10,14],[827,1216,0,15,19],[1383,2049,0,21,28],[2105,2188,0,29,32],[2272,2744,0,33,41],[2827,3433,0,42,46],[4091,5202,1,0,9],[5814,5952,1,11,15],[6008,6147,1,16,21],[6230,6452,1,22,26],[6508,6702,1,27,32],[6814,6980,1,33,36],[7036,7397,1,37,44],[7452,7536,1,45,48],[7536,7647,1,49,50],[7702,7897,2,0,4],[7980,8702,2,5,10],[8841,8925,2,12,15],[8952,9091,2,16,20],[9202,9452,2,21,26],[9508,9564,2,27,29],[9647,9758,2,30,33],[9814,9897,2,34,36],[9980,10286,2,37,43],[10397,10702,2,44,47],[11577,11799,3,0,4],[11855,12049,3,5,9],[12188,13241,3,10,19],[13864,14142,3,21,25],[14170,14336,3,26,31],[14392,14920,3,32,36],[15031,15142,3,37,40],[15198,15948,3,41,48],[16031,16389,4,0,2],[17009,17343,4,4,9],[17454,17981,4,10,17],[18093,19114,4,18,26],[19744,20050,5,0,4],[20078,20189,5,5,8],[20328,20772,5,9,13],[20911,21716,5,14,18],[22302,22663,5,20,25],[22719,23025,5,26,30],[23080,23525,5,31,35],[23636,23719,5,37,40],[23747,23830,5,41,45],[23886,23969,5,46,48],[24025,24275,5,49,52],[24358,24691,6,0,4],[24747,24941,6,5,10],[25136,25386,6,11,15],[25441,25608,6,16,20],[25719,26387,6,21,28]],"sentences":[[22,3433,0,7,"sly"],[4091,5202,8,8,"sly"],[5814,10702,9,26,"sly"],[11577,13241,27,29,"sly"],[13864,16389,30,35,"grave"],[17009,19114,36,38,"angry"],[19744,21716,39,42,"warning"],[22302,26387,43,54,"warning"]],"visemes":{"t":[0,22,77,188,383,466,549,660,716,827,883,1105,1216,1383,1494,1549,1688,1772,1883,2105,2133,2188,2272,2327,2438,2494,2744,2827,2883,3105,3433,4091,4146,4424,4535,4646,4729,5202,5814,5869,6008,6091,6147,6230,6397,6564,6619,6675,6758,6869,6925,7036,70