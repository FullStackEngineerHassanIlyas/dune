{"v":1,"id":"harkonnen/m8-briefing","ms":26020,"lines":["Our enemies have finally done something clever.","The Atreides and the Ordos have joined forces,","each with a base here. The Emperor's doing, again;","his Sardaukar will not be far away.","Destroy them both, and Arrakis is all but ours.","Two Houses, one army, and twice the corpses.","I expect you to enjoy this one."],"words":[[119,230,0,0,3],[341,785,0,4,11],[813,952,0,12,16],[1063,1591,0,17,24],[1674,2035,0,25,29],[2146,2619,0,30,39],[2730,3384,0,40,46],[3948,4059,1,0,3],[4114,4864,1,4,12],[4892,4976,1,13,16],[5003,5114,1,17,20],[5281,5642,1,21,26],[5698,5837,1,27,31],[5892,6309,1,32,38],[6420,7253,1,39,45],[7503,7726,2,0,4],[7781,7892,2,5,9],[7920,7976,2,10,11],[8031,8392,2,12,16],[8448,8977,2,17,21],[9532,9636,2,23,26],[9747,10191,2,27,36],[10275,10691,2,37,42],[10775,11414,2,44,49],[11552,11719,3,0,3],[11803,12386,3,4,13],[12497,12608,3,14,18],[12664,12830,3,19,22],[12886,12969,3,23,25],[13108,13386,3,26,29],[13441,14086,3,30,34],[14678,15178,4,0,7],[15205,15372,4,8,12],[15428,15900,4,13,17],[16011,16094,4,19,22],[16150,16817,4,23,30],[16900,17011,4,31,33],[17122,17261,4,34,37],[17317,17428,4,38,41],[17539,18215,4,42,46],[18771,18899,5,0,3],[19010,19677,5,4,10],[19760,19982,5,12,15],[20177,20566,5,16,20],[20677,20760,5,22,25],[20816,21177,5,26,31],[21232,21316,5,32,35],[21371,22233,5,36,43],[22857,22995,6,0,1],[23051,23551,6,2,8],[23607,23690,6,9,12],[23773,23884,6,13,15],[23940,24579,6,16,21],[24662,24968,6,22,26],[24968,25456,6,27,30]],"sentences":[[119,3384,0,6,"sly"],[3948,8977,7,19,"sly"],[9532,14086,20,30,"grave"],[14678,18215,31,39,"grave"],[18771,22233,40,47,"angry"],[22857,25456,48,54,"pleased"]],"visemes":{"t":[0,63,146,174,202,285,424,480,591,841,896,952,1063,1119,1258,1369,1424,1508,1591,1674,1730,1924,2035,2146,2202,2313,2424,2508,2619,2730,2813,2869,3008,3119,3384,3948,4003,4114,4198,4281,4337,4892,4920,5003,5059,5114,5198,5392,5503,5587,5726,5781,5892,5948,6142,6309,6420,6476,6726,7253,744